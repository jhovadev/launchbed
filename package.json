{
  "name": "launchbed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Launchbed \u2014 generate mobile-first starters. mise for tools, just for complex commands.",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.23.4",
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@android-initializr/catalog": "workspace:*",
    "@android-initializr/cli": "workspace:*",
    "@android-initializr/design-tokens": "workspace:*",
    "@android-initializr/generator": "workspace:*",
    "@android-initializr/preview": "workspace:*",
    "@android-initializr/resolver": "workspace:*",
    "@android-initializr/schema": "workspace:*",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "preview": "bun run --cwd apps/web start",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test packages tests",
    "templates:embed": "bun run scripts/embed-templates.ts",
    "templates:check": "bun run scripts/embed-templates.ts --check",
    "cli": "bun run packages/cli/src/index.ts",
    "generate:example": "bun run packages/cli/src/index.ts generate --config examples/basic.json --out build/example.zip",
    "check:astro": "bun run --cwd apps/web check",
    "runtime:parser-test": "node --test scripts/runtime/devices.node.test.mjs",
    "android:runtime-compile": "bun run scripts/android-runtime.ts test --all",
    "android:runtime-test": "bun run scripts/android-runtime.ts test --all --run",
    "benchmark:generator": "bun run scripts/performance-baseline.ts generator",
    "benchmark:android": "bun run scripts/performance-baseline.ts android",
    "benchmark:parser-test": "node --test scripts/performance/metrics.node.test.mjs",
    "integrity:check": "bun run scripts/integrity-check.ts",
    "integrity:release": "bun run scripts/integrity-check.ts --release",
    "integrity:patch-replay": "node scripts/integrity/patch-replay.mjs",
    "integrity:parser-test": "node --test scripts/integrity/gates.node.test.mjs",
    "release:parser-test": "node --test scripts/release/native-apk.node.test.mjs",
    "release:audit": "bun run scripts/release-audit.ts build --all",
    "deploy:smoke": "node scripts/deployment/vercel-smoke.mjs",
    "deploy:ssr-smoke": "node scripts/deployment/local-ssr-smoke.mjs",
    "deploy:check": "node scripts/deployment/preflight.mjs"
  }
}
