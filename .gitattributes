# Text is LF in the worktree, except Windows entry points (.bat, .cmd, .ps1)
# which must be CRLF so generated projects run on Windows.
# scripts/embed-templates.ts canonicalizes to these endings before embedding.
* text=auto eol=lf

*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf
*.jar           binary
*.png           binary
*.webp          binary
*.zip           binary
gradlew         text eol=lf
templates/**/gradlew text eol=lf
