{
  "id": "app-starter",
  "version": "0.1.0",
  "name": "App Starter",
  "description": "Onboarding, auth, profile, dashboard and settings on the Compose foundation.",
  "category": "application",
  "status": "beta",
  "baseTemplate": "android-compose-minimal",
  "requiredAddons": [
    "ui/foundation",
    "ui/navigation",
    "ui/onboarding",
    "ui/auth",
    "ui/profile",
    "ui/dashboard",
    "ui/settings",
    "tooling/scrcpy",
    "tooling/github-actions"
  ],
  "optionalAddons": [],
  "defaultTheme": {
    "seedColor": "#006C4C",
    "schemeVariant": "tonalSpot",
    "defaultMode": "system",
    "typography": {
      "fontFamily": "default"
    },
    "shape": {
      "cornerRadius": 12
    },
    "spacing": {
      "xs": 4,
      "sm": 8,
      "md": 16,
      "lg": 24,
      "xl": 32
    },
    "components": {
      "card": {
        "cornerRadius": 16,
        "elevation": 1
      },
      "button": {
        "cornerRadius": 20,
        "minHeight": 48
      }
    },
    "overrides": {
      "light": {},
      "dark": {}
    }
  },
  "previewScreens": [
    "onboarding",
    "login",
    "register",
    "profile",
    "dashboard",
    "settings"
  ],
  "compatibility": {
    "minSdk": 26,
    "notes": [
      "Beta: generated screens use DataStore for onboarding and an in-memory auth fake. Not a production backend.",
      "Expo and Flutter get the onboarding, auth, profile and dashboard ports (no settings screen yet) on top of the official templates."
    ]
  },
  "capabilities": [
    "starter",
    "onboarding",
    "auth-ui",
    "profile",
    "navigation",
    "settings"
  ],
  "targets": [
    "android-compose",
    "expo",
    "flutter"
  ],
  "targetAddons": {
    "expo": [
      "tooling/github-actions",
      "tooling/scrcpy",
      "ui/auth",
      "ui/dashboard",
      "ui/navigation",
      "ui/onboarding",
      "ui/profile",
      "ui/settings"
    ],
    "flutter": [
      "tooling/github-actions",
      "tooling/scrcpy",
      "ui/auth",
      "ui/dashboard",
      "ui/navigation",
      "ui/onboarding",
      "ui/profile",
      "ui/settings"
    ]
  }
}
