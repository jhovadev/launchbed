{
  "id": "local-notes",
  "version": "0.1.0",
  "name": "Local Notes",
  "description": "Room-backed notes with reactive Compose UI.",
  "category": "application",
  "status": "beta",
  "baseTemplate": "android-compose-minimal",
  "requiredAddons": [
    "storage/room",
    "ui/foundation",
    "ui/navigation",
    "ui/notes"
  ],
  "optionalAddons": [],
  "defaultTheme": {
    "seedColor": "#8C4A2F",
    "schemeVariant": "tonalSpot",
    "defaultMode": "system",
    "typography": {
      "fontFamily": "default"
    },
    "shape": {
      "cornerRadius": 12
    },
    "spacing": {
      "xs": 4,
      "sm": 8,
      "md": 16,
      "lg": 24,
      "xl": 32
    },
    "components": {
      "card": {
        "cornerRadius": 16,
        "elevation": 1
      },
      "button": {
        "cornerRadius": 20,
        "minHeight": 48
      }
    },
    "overrides": {
      "light": {},
      "dark": {}
    }
  },
  "previewScreens": [
    "welcome",
    "notes"
  ],
  "compatibility": {
    "minSdk": 26,
    "notes": [
      "Room remains beta."
    ]
  },
  "capabilities": [
    "notes",
    "room",
    "offline"
  ]
}
