set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments

# Generated by Launchbed. Run `just --list` for all tasks.
# On Windows, `just` requires a POSIX shell (Git Bash). The same tasks are also
# available directly as PowerShell scripts under scripts/.

default:
    @just --list

# Report tool, SDK and device status
doctor:
    @bash scripts/task.sh doctor

# Check and (with INSTALL=1) install the Android SDK packages
sdk-setup:
    @bash scripts/task.sh sdk-setup

# Assemble a debug APK
build:
    ./gradlew :app:assembleDebug

# Run JVM unit tests (no device required)
test:
    ./gradlew :app:testDebugUnitTest

# Run Android Lint
lint:
    ./gradlew :app:lintDebug

# List connected devices
devices:
    @bash scripts/task.sh device devices

# Install the debug APK, prompting when several devices are connected
install:
    @bash scripts/task.sh device install

# Launch the installed app on the selected device
launch:
    @bash scripts/task.sh device launch

# Build, install and launch the app
run:
    @bash scripts/task.sh device run

# Stream logcat filtered to this app's process
logs:
    @bash scripts/task.sh device logs

# Alias of logs
logcat:
    @bash scripts/task.sh device logs

# Mirror the selected device with scrcpy (must be installed separately)
scrcpy *args:
    @bash scripts/task.sh scrcpy "$@"

# Mirror with scrcpy --stay-awake (same as just scrcpy)
mirror *args:
    @bash scripts/task.sh scrcpy mirror "$@"

# Enable adb tcpip via scrcpy --tcpip and mirror over Wi-Fi
mirror-wifi *args:
    @bash scripts/task.sh scrcpy mirror-wifi "$@"

# Record the device (default capture.mp4). Extra official scrcpy flags are forwarded.
record *args:
    @bash scripts/task.sh scrcpy record "$@"

# Capture a PNG screenshot of the selected device
screenshot *args:
    @bash scripts/task.sh device screenshot "$@"

# Clear this app's data on the selected device
clear-data:
    @bash scripts/task.sh device clear-data

# Uninstall this app from the selected device
uninstall:
    @bash scripts/task.sh device uninstall

# Open a URI on the selected device (https://... or a custom scheme)
deeplink *args:
    @bash scripts/task.sh device deeplink "$@"

# Remove Gradle build outputs
clean:
    ./gradlew clean

# Build and print the APK path
apk: build
    @find app/build/outputs/apk/debug -name '*.apk' -type f -print

# Addon just recipes are inserted above this marker. Do not remove it.
# @launchbed-slot just-recipes
