root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 140
# Read by ktlint (tooling/format); inert otherwise. Compose functions are PascalCase.
ktlint_code_style = android_studio
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{xml,toml,md,yml,yaml,json}]
indent_size = 2

[*.ps1]
end_of_line = crlf
