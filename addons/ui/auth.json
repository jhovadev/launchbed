{
  "id": "ui/auth",
  "version": "0.1.0",
  "displayName": "Auth screens",
  "description": "Login and register UI with validation and an in-memory fake repository. No real backend or secrets.",
  "category": "ui",
  "status": "beta",
  "dependencies": [
    "ui/navigation"
  ],
  "conflicts": [],
  "capabilities": [
    "auth-ui",
    "compose-ui",
    "material3"
  ],
  "requirements": {
    "minSdk": 24,
    "compileSdk": 34,
    "jdk": 17
  },
  "fileOperations": [
    {
      "type": "merge",
      "target": "version-catalog",
      "alias": "lifecycleviewmodelcompose",
      "module": "androidx.lifecycle:lifecycle-viewmodel-compose",
      "version": "2.11.0"
    },
    {
      "type": "merge",
      "target": "version-catalog",
      "alias": "lifecycleruntimecompose",
      "module": "androidx.lifecycle:lifecycle-runtime-compose",
      "version": "2.11.0"
    },
    {
      "type": "merge",
      "target": "app-dependencies",
      "alias": "lifecycleviewmodelcompose"
    },
    {
      "type": "merge",
      "target": "app-dependencies",
      "alias": "lifecycleruntimecompose"
    },
    {
      "type": "add",
      "path": "app/src/main/java/{{packagePath}}/ui/auth/AuthValidator.kt",
      "template": "ui/auth-validator"
    },
    {
      "type": "add",
      "path": "app/src/main/java/{{packagePath}}/ui/auth/AuthRepository.kt",
      "template": "ui/auth-repository"
    },
    {
      "type": "add",
      "path": "app/src/main/java/{{packagePath}}/ui/auth/AuthViewModel.kt",
      "template": "ui/auth-viewmodel"
    },
    {
      "type": "add",
      "path": "app/src/main/java/{{packagePath}}/ui/auth/LoginScreen.kt",
      "template": "ui/auth-login-screen"
    },
    {
      "type": "add",
      "path": "app/src/main/java/{{packagePath}}/ui/auth/RegisterScreen.kt",
      "template": "ui/auth-register-screen"
    },
    {
      "type": "add",
      "path": "app/src/test/java/{{packagePath}}/ui/auth/AuthValidatorTest.kt",
      "template": "ui/auth-validator-test"
    },
    {
      "type": "add",
      "path": "app/src/androidTest/java/{{packagePath}}/ui/auth/LoginScreenTest.kt",
      "template": "ui/auth-login-test"
    },
    {
      "type": "add",
      "path": "app/src/androidTest/java/{{packagePath}}/ui/auth/RegisterScreenTest.kt",
      "template": "ui/auth-register-test"
    },
    {
      "type": "add",
      "path": "docs/AUTH.md",
      "template": "ui/auth-docs"
    },
    {
      "type": "insert",
      "path": "app/src/main/java/{{packagePath}}/ui/navigation/AppRoot.kt",
      "slot": "app-imports",
      "template": "ui/auth-import"
    },
    {
      "type": "insert",
      "path": "app/src/main/java/{{packagePath}}/ui/navigation/AppRoot.kt",
      "slot": "app-routes",
      "template": "ui/auth-route"
    },
    {
      "type": "insert",
      "path": "app/src/main/java/{{packagePath}}/ui/navigation/AppRoot.kt",
      "slot": "app-entries",
      "template": "ui/auth-entry"
    }
  ],
  "compatibility": {
    "android": [
      "7.0+"
    ],
    "notes": [
      "Beta: UI plus an in-memory fake AuthRepository. Not a real auth backend.",
      "Demo account demo@example.com / demo-password is for local previews only.",
      "Firebase, Supabase or a custom API are documented as future addons; see docs/AUTH.md.",
      "Never present this fake session as secure authentication."
    ]
  },
  "license": "MIT",
  "docsUrl": "https://developer.android.com/develop/ui/compose"
}
