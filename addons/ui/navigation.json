{
  "id": "ui/navigation",
  "version": "0.1.0",
  "displayName": "Navigation",
  "description": "Type-safe Navigation 3 root, back stack and composable destination registration.",
  "category": "ui",
  "status": "beta",
  "dependencies": [],
  "conflicts": [],
  "capabilities": [
    "navigation",
    "compose-navigation",
    "material3"
  ],
  "requirements": {
    "minSdk": 24,
    "compileSdk": 34,
    "jdk": 17
  },
  "fileOperations": [
    {
      "type": "merge",
      "target": "version-catalog",
      "alias": "composeuitestjunit4",
      "module": "androidx.compose.ui:ui-test-junit4"
    },
    {
      "type": "merge",
      "target": "version-catalog",
      "alias": "composeuitestmanifest",
      "module": "androidx.compose.ui:ui-test-manifest"
    },
    {
      "type": "merge",
      "target": "version-catalog",
      "alias": "androidxtestextjunit",
      "module": "androidx.test.ext:junit",
      "version": "1.3.0"
    },
    {
      "type": "merge",
      "target": "version-catalog",
      "alias": "navigation3runtime",
      "module": "androidx.navigation3:navigation3-runtime",
      "version": "1.2.1"
    },
    {
      "type": "merge",
      "target": "version-catalog",
      "alias": "navigation3ui",
      "module": "androidx.navigation3:navigation3-ui",
      "version": "1.2.1"
    },
    {
      "type": "merge",
      "target": "version-catalog",
      "alias": "kotlinxserializationjson",
      "module": "org.jetbrains.kotlinx:kotlinx-serialization-json",
      "version": "1.8.1"
    },
    {
      "type": "merge",
      "target": "version-catalog",
      "alias": "serialization",
      "pluginId": "org.jetbrains.kotlin.plugin.serialization",
      "version": "2.3.10"
    },
    {
      "type": "merge",
      "target": "version-catalog",
      "alias": "materialiconscore",
      "module": "androidx.compose.material:material-icons-core"
    },
    {
      "type": "merge",
      "target": "root-plugins",
      "alias": "serialization"
    },
    {
      "type": "merge",
      "target": "app-plugins",
      "alias": "serialization"
    },
    {
      "type": "merge",
      "target": "app-dependencies",
      "alias": "navigation3runtime"
    },
    {
      "type": "merge",
      "target": "app-dependencies",
      "alias": "navigation3ui"
    },
    {
      "type": "merge",
      "target": "app-dependencies",
      "alias": "kotlinxserializationjson"
    },
    {
      "type": "merge",
      "target": "app-dependencies",
      "alias": "materialiconscore"
    },
    {
      "type": "add",
      "path": "app/src/main/java/{{packagePath}}/ui/navigation/AppRoot.kt",
      "template": "ui/navigation-app-root"
    },
    {
      "type": "add",
      "path": "app/src/main/java/{{packagePath}}/ui/navigation/WelcomeScreen.kt",
      "template": "ui/navigation-welcome-screen"
    },
    {
      "type": "insert",
      "path": "app/src/main/java/{{packagePath}}/MainActivity.kt",
      "slot": "main-content",
      "template": "ui/navigation-main-content"
    },
    {
      "type": "insert",
      "path": "app/build.gradle.kts",
      "slot": "app-dependencies",
      "template": "ui/navigation-test-deps"
    },
    {
      "type": "add",
      "path": "app/src/androidTest/java/{{packagePath}}/ui/navigation/NavigationSmokeTest.kt",
      "template": "ui/navigation-test"
    }
  ],
  "compatibility": {
    "android": [
      "7.0+"
    ],
    "notes": [
      "Beta in F1.2: validated by generated-project compilation.",
      "Navigation 3 1.2.1 with kotlinx.serialization 1.8.1.",
      "No multiple NavDisplay instances."
    ]
  },
  "license": "MIT",
  "docsUrl": "https://developer.android.com/guide/navigation"
}
