{
  "id": "storage/room",
  "version": "0.1.0",
  "displayName": "Room (SQLite)",
  "description": "Local SQLite persistence with Room, KSP code generation, schema export and reactive DAOs.",
  "category": "storage",
  "status": "beta",
  "dependencies": [],
  "conflicts": [
    "storage/sqlite-direct",
    "storage/turso",
    "storage/sqld-remote",
    "storage/libsql-android"
  ],
  "capabilities": [
    "persistence",
    "local-database",
    "migrations",
    "reactive-queries",
    "schema-export"
  ],
  "requirements": {
    "minSdk": 24,
    "compileSdk": 34,
    "jdk": 17
  },
  "fileOperations": [
    {
      "type": "merge",
      "target": "version-catalog",
      "alias": "room",
      "version": "2.8.5"
    },
    {
      "type": "merge",
      "target": "version-catalog",
      "alias": "room",
      "versionRef": "room",
      "pluginId": "androidx.room"
    },
    {
      "type": "merge",
      "target": "version-catalog",
      "alias": "ksp",
      "version": "2.3.10",
      "pluginId": "com.google.devtools.ksp"
    },
    {
      "type": "merge",
      "target": "version-catalog",
      "alias": "roomruntime",
      "module": "androidx.room:room-runtime",
      "versionRef": "room"
    },
    {
      "type": "merge",
      "target": "version-catalog",
      "alias": "androidxtestextjunit",
      "module": "androidx.test.ext:junit",
      "version": "1.3.0"
    },
    {
      "type": "merge",
      "target": "version-catalog",
      "alias": "roomcompiler",
      "module": "androidx.room:room-compiler",
      "versionRef": "room"
    },
    {
      "type": "merge",
      "target": "root-plugins",
      "alias": "ksp"
    },
    {
      "type": "merge",
      "target": "root-plugins",
      "alias": "room"
    },
    {
      "type": "merge",
      "target": "app-plugins",
      "alias": "ksp"
    },
    {
      "type": "merge",
      "target": "app-plugins",
      "alias": "room"
    },
    {
      "type": "merge",
      "target": "app-dependencies",
      "alias": "roomruntime"
    },
    {
      "type": "insert",
      "path": "app/build.gradle.kts",
      "slot": "app-dependencies",
      "template": "storage/room-ksp"
    },
    {
      "type": "insert",
      "path": "app/build.gradle.kts",
      "slot": "app-dependencies",
      "template": "storage/room-androidtest-deps"
    },
    {
      "type": "insert",
      "path": "app/build.gradle.kts",
      "slot": "app-room-config",
      "template": "storage/room-config"
    },
    {
      "type": "add",
      "path": "app/src/main/java/{{packagePath}}/data/local/NoteEntity.kt",
      "template": "storage/room-note-entity"
    },
    {
      "type": "add",
      "path": "app/src/main/java/{{packagePath}}/data/local/NoteDao.kt",
      "template": "storage/room-note-dao"
    },
    {
      "type": "add",
      "path": "app/src/main/java/{{packagePath}}/data/local/AppDatabase.kt",
      "template": "storage/room-app-database"
    },
    {
      "type": "add",
      "path": "app/src/main/java/{{packagePath}}/data/local/DatabaseProvider.kt",
      "template": "storage/room-database-provider"
    },
    {
      "type": "add",
      "path": "app/src/main/java/{{packagePath}}/data/repository/NoteRepository.kt",
      "template": "storage/room-note-repository"
    },
    {
      "type": "add",
      "path": "app/schemas/{{packagePath}}/data/local/AppDatabase/1.json",
      "template": "storage/room-schema"
    },
    {
      "type": "add",
      "path": "app/src/androidTest/java/{{packagePath}}/data/local/NoteDaoTest.kt",
      "template": "storage/room-note-dao-test"
    },
    {
      "type": "add",
      "path": "app/src/test/java/{{packagePath}}/data/local/NoteEntityTest.kt",
      "template": "storage/room-note-entity-test"
    }
  ],
  "compatibility": {
    "android": [
      "7.0+"
    ],
    "notes": [
      "Beta in F1.1.1: validated by a generated-project smoke build.",
      "Room 2.8.5 with KSP 2.3.10 and Kotlin/Compose 2.3.10; runtime instrumentation pending.",
      "No KAPT, Hilt, Koin, remote sync or CRUD UI.",
      "Room exports schema version 1 into app/schemas during build.",
      "Upstream licenses: Apache-2.0 (androidx.room, KSP)."
    ]
  },
  "license": "MIT",
  "docsUrl": "https://developer.android.com/training/data-storage/room"
}
