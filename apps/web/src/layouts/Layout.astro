---
import "@android-initializr/preview/styles.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Generate a native Android project with Kotlin and Jetpack Compose." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="brand">
        <span class="brand-mark" aria-hidden="true">K</span>
        <span class="brand-text">
          Kotlaunch
          <span class="brand-sub">native first · MIT</span>
        </span>
      </div>
      <nav class="site-nav" aria-label="Primary">
        <a href="#configurator">Configurator</a>
        <a href="/api/catalog">Catalog API</a>
        <a href="#scope">About</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer" id="scope">
      <div>
        <p class="footer-title">Kotlaunch · Native Android Initializr</p>
        <p>
          Generate native Kotlin + Jetpack Compose projects from reproducible presets. The web and CLI
          share a deterministic generator. Some addons remain beta until their device tests pass.
          This web preview is a simulation, not a running Android emulator.
        </p>
      </div>
      <p class="footer-license">MIT licensed · No telemetry · No Android Studio required</p>
    </footer>
  </body>
</html>
