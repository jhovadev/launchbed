---
import "@android-initializr/preview/styles.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Launchbed generates native Android starters with Kotlin, Jetpack Compose, mise and just." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="brand">
        <span class="brand-mark" aria-hidden="true">L</span>
        <span class="brand-text">
          Launchbed
          <span class="brand-sub">mobile first · MIT</span>
        </span>
      </div>
      <nav class="site-nav" aria-label="Primary">
        <a href="#configurator">Build</a>
        <a href="#how-it-works">How it works</a>
        <a href="https://github.com/jhovadev/launchbed" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer" id="scope">
      <div>
        <p class="footer-title">Launchbed · mobile-first starters</p>
        <p>
          Native Kotlin + Jetpack Compose projects from reproducible presets. The web and CLI
          share one deterministic generator. Generated apps use mise for tools and just for
          commands. Some add-ons remain beta pending device tests. The live preview is
          illustrative, not an Android emulator.
        </p>
      </div>
      <p class="footer-license">MIT licensed · No telemetry · No Android Studio required</p>
    </footer>
  </body>
</html>
