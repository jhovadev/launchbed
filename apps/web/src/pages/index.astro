---
import Layout from "../layouts/Layout.astro";
import Configurator from "../components/Configurator";
import { buildCatalog, ALL_PRESETS } from "@launchbed/catalog";

const catalog = buildCatalog();
---

<Layout title="Launchbed — Build native Android apps, minus the setup">
  <section class="hero hero-new" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="hero-spark" aria-hidden="true"></span> Native Android, simplified</p>
      <h1 id="hero-title">Ship the app.<br /><em>Skip the setup.</em></h1>
      <p class="lede">
        Start with Kotlin and Jetpack Compose. Choose the features you need,
        personalize your project and download buildable source — or copy the equivalent CLI command.
      </p>
      <div class="hero-actions">
        <a href="#configurator" class="button primary">Build my project <span aria-hidden="true">→</span></a>
        <a href="/components">Component catalog</a>
        <a href="https://github.com/jhovadev/launchbed" class="hero-source" target="_blank" rel="noopener noreferrer">View open source code <span aria-hidden="true">↗</span></a>
      </div>
      <ul class="chips" aria-label="Project features">
        <li>No account</li>
        <li>Native Kotlin</li>
        <li>CLI-first</li>
        <li>MIT licensed</li>
      </ul>
    </div>
    <div class="hero-guide" aria-label="How Launchbed works">
      <p class="guide-eyebrow">A project in five steps</p>
      <div class="guide-step"><span class="guide-number">01</span><div><strong>Name the project</strong><p>App name and application ID.</p></div></div>
      <div class="guide-step"><span class="guide-number">02</span><div><strong>Pick a preset</strong><p>Minimal, Starter, Notes or Catalog.</p></div></div>
      <div class="guide-step"><span class="guide-number">03</span><div><strong>Add capabilities</strong><p>Room, navigation and more. Planned items stay visible but disabled.</p></div></div>
      <div class="guide-step"><span class="guide-number">04</span><div><strong>Choose a theme</strong><p>Material 3 colors from a seed.</p></div></div>
      <div class="guide-step"><span class="guide-number">05</span><div><strong>Review and download</strong><p>Copy the CLI command or download a verified ZIP.</p></div></div>
      <div class="guide-bottom"><span class="guide-ready-dot" aria-hidden="true"></span> Buildable source. No hosted app builder.</div>
    </div>
  </section>

  <section id="configurator" aria-label="Project configurator">
    <Configurator catalog={catalog} presets={ALL_PRESETS} client:load />
  </section>

  <section class="facts" id="how-it-works" aria-labelledby="facts-title">
    <p class="eyebrow">Built for developers</p>
    <h2 id="facts-title">Real projects, not mockups.</h2>
    <div class="facts-grid">
      <article><span class="fact-symbol" aria-hidden="true">&#123; &#125;</span><h3>Real Android code</h3><p>Kotlin, Compose Material 3, a Gradle wrapper, version catalog and ready-to-run tooling.</p></article>
      <article><span class="fact-symbol" aria-hidden="true">≡</span><h3>Composable features</h3><p>Addons are validated against dependencies, conflicts and SDK requirements before packaging.</p></article>
      <article><span class="fact-symbol" aria-hidden="true">✓</span><h3>Reproducible output</h3><p>The generator verifies ZIP contents against a plan. Identical requests produce identical ZIP bytes.</p></article>
    </div>
    <p class="facts-note">Some templates and addons are beta while Android device tests are pending. Planned features are not offered as downloadable code.</p>
  </section>
</Layout>
