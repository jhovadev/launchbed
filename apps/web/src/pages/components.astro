---
import Layout from "../layouts/Layout.astro";
import ComponentCatalog, { type CatalogComponent } from "../components/ComponentCatalog";
import { componentSources, loadComponentCatalog } from "@launchbed/generator";

// Embedded registry: works under Bun, Node SSR and Vercel without repository access.
const components: CatalogComponent[] = loadComponentCatalog().components.map((component) => ({
  ...component,
  props: component.props as CatalogComponent["props"],
  sources: componentSources(component),
}));
---

<Layout title="Components — Launchbed" active="components"
  description="Universal components for Android Compose, Expo and Flutter, copied into your project shadcn-style.">
  <section class="border-b" aria-labelledby="components-title">
    <div class="mx-auto flex max-w-screen-2xl flex-col gap-4 px-4 py-10 sm:px-6 lg:px-8">
      <p class="text-sm font-medium text-muted-foreground">Component registry</p>
      <h1 id="components-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">Universal components, copied into your project.</h1>
      <p class="max-w-2xl text-muted-foreground text-pretty">
        One contract, three native implementations: Jetpack Compose, Expo (React Native) and Flutter. Like shadcn/ui, Launchbed copies
        the source into your app. It is yours to edit, not a runtime dependency.
      </p>
      <div class="flex flex-wrap gap-2 text-sm">
        <code class="rounded-md border bg-muted/50 px-3 py-1.5 font-mono text-xs">launchbed components --json</code>
        <code class="rounded-md border bg-muted/50 px-3 py-1.5 font-mono text-xs">launchbed add &lt;name&gt; [--force]</code>
      </div>
    </div>
  </section>
  <section id="catalog" class="mx-auto max-w-screen-2xl px-4 py-8 sm:px-6 lg:px-8" aria-label="Component catalog">
    <ComponentCatalog components={components} client:load />
  </section>
</Layout>
